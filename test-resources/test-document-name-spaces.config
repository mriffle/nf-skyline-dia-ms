//
// Positive test: a Skyline document name containing a space.
//
// 'my doc' names the document, the DIA-NN library (my doc_diann_lib.blib) and, because the
// document name is also the QC project name, the QC report (my doc_qc_report.html). The
// longest route is taken on purpose: metadata and minimize are both on, so the name passes
// through merge -> annotate -> minimize, and the result is uploaded and imported.
//
// A stub run executes neither Skyline nor dia_qc, so this checks the wiring only: the
// channel joins keyed on file names, the checksum table (CALCULATE_MD5 and WRITE_FILE_STATS
// have no stub and really run), and the upload manifest. Before the fix this config failed
// in combine_file_hashes, which split md5sum output on whitespace and so cut
// 'my doc_qc_report.qmd' down to 'my'.
//
// Expected: success, with final document 'my doc_annotated_minimized.sky.zip'.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    replicate_metadata = 'test-resources/test-replicate-metadata.tsv'

    skyline.document_name = 'my doc'
    skyline.minimize = true
    skyline.skyr_file = 'test-resources/test-report.skyr'

    qc_report.skip = false

    // The URL is never contacted: stub runs only record the destination.
    panorama.upload = true
    panorama.upload_url = 'https://panoramaweb.org/_webdav/stub/%40files/test'
    panorama.import_skyline = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
