//
// Positive test: a spectral library and mzML files with spaces in their names on the
// DIA-NN path.
//
// A .blib library is converted for DIA-NN in two steps (ENCYCLOPEDIA_BLIB_TO_DLIB, then
// ENCYCLOPEDIA_DLIB_TO_TSV), and both name their output after the library. The MS files
// are mzML, which are used as they are instead of going through msconvert. See
// test-input-file-spaces.config for what a stub run can and cannot show.
//
// Expected: success, with final document 'final.sky.zip'.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/spaced inputs/mzml window'
    quant_spectra_glob = '*.mzML'

    spectral_library = 'test-resources/spaced inputs/test library.blib'
    fasta = 'test-resources/spaced inputs/test fasta.fasta'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
