//
// Negative test: a Skyline document name that starts with '-'.
//
// The document's file names are handed to command-line tools (tee, md5sum, unzip), which
// read a leading '-' as an option.
//
// Expected: non-zero exit before any task runs, with a message naming the parameter. See
// .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    skyline.document_name = '-final'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
