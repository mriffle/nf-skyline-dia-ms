//
// Positive test: spaces in the document name and in a batch name, in multi-batch mode.
//
// The documents are named '<document_name>_<batch>', so this run makes
// 'my doc_Batch A.sky.zip' and 'my doc_Plate2.sky.zip'. The batch name is also the QC
// project name and the prefix of every Skyline report ('Batch A_TestReport.report.tsv'),
// and it names the batch's mzML upload directory.
//
// No metadata and no minimize, so the merge step writes the final documents itself. See
// test-document-name-spaces.config for the annotate/minimize route and for what a stub run
// can and cannot show.
//
// Expected: success.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Batch A': 'test-resources/narrow-window',
                         'Plate2' : 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    skyline.document_name = 'my doc'
    skyline.skyr_file = 'test-resources/test-report.skyr'

    qc_report.skip = false

    // The URL is never contacted: stub runs only record the destination.
    panorama.upload = true
    panorama.upload_url = 'https://panoramaweb.org/_webdav/stub/%40files/test'
    panorama.import_skyline = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
