//
// Positive test: input files with spaces in their names on the EncyclopeDIA path.
//
// Narrow- and wide-window data, the FASTA and a .blib spectral library all have a space in
// their name. The .blib makes ENCYCLOPEDIA_BLIB_TO_DLIB run, and the narrow-window data
// makes ENCYCLOPEDIA_CREATE_ELIB run twice. See test-input-file-spaces.config for what a
// stub run can and cannot show.
//
// Expected: success, with final document 'final.sky.zip'.
//

params {

    search_engine = 'encyclopedia'

    quant_spectra_dir = 'test-resources/spaced inputs/wide window'
    quant_spectra_glob = '*.raw'

    chromatogram_library_spectra_dir = 'test-resources/spaced inputs/narrow window'
    chromatogram_library_spectra_glob = '*.raw'

    spectral_library = 'test-resources/spaced inputs/test library.blib'
    fasta = 'test-resources/spaced inputs/test fasta.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
