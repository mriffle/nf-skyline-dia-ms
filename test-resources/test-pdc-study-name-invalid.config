//
// Negative test: a PDC study name that cannot be used as a document name.
//
// On PDC runs the default document name 'final' is replaced by the study name. A name
// fetched from PDC is reduced to letters and underscores by PDC_client, but with
// pdc.metadata_tsv the name comes from pdc.study_name and is used as it is, so it gets the
// same check as skyline.document_name.
//
// Expected: non-zero exit before any task runs, with a message naming the parameter. See
// .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.metadata_tsv = 'test-resources/test-pdc-metadata.tsv'
    pdc.study_name = 'CPTAC: discovery/DIA'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
