//
// Negative test: a batch whose spectra folder really holds no matching file.
//
// 'Plate2' is a Panorama Public folder. No server is asked in a stub run: the stub of the
// listing step returns an empty list, which is what a folder with no file matching the glob
// looks like. Whether every batch resolved at least one file is only known once the
// listings are in, so this error is raised from inside the channels, by the validation
// barrier in subworkflows/get_ms_files.nf, and not while the workflow is being built. (A
// local directory without a match is caught earlier, by another check with another message.)
//
// The barrier stays silent when the run is already being aborted, so that it cannot replace
// the real error with this one (audit item R20). This test is the other half: on a healthy
// run with a batch that matched nothing, it must still speak.
//
// Expected: non-zero exit and "No spectra files matched the glob/regex:", listing the
// Plate2 folder and not Plate1. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1': 'test-resources/wide-window',
                         'Plate2': 'https://panoramaweb.org/_webdav/Panorama%20Public/stub/%40files/RawFiles']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
