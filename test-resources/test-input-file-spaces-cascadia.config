//
// Positive test: MS files with spaces in their names on the Cascadia path.
//
// Every Cascadia step names its output after the MS file it was given
// (`<name>.ssl`, `<name>.fixed.ssl`, `output_file_stats_<name>.txt`). See
// test-input-file-spaces.config for what a stub run can and cannot show.
//
// Expected: success, with final document 'final.sky.zip'.
//

params {

    search_engine = 'cascadia'

    quant_spectra_dir = 'test-resources/spaced inputs/wide window'
    quant_spectra_glob = '*.raw'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
