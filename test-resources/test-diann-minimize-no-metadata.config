//
// Stub-run config: DIA-NN search with the minimize step and no replicate metadata.
//
// Without metadata there is no annotation step, so the merged document is handed straight
// from SKYLINE_MERGE_RESULTS to SKYLINE_MINIMIZE_DOCUMENT. test-diann-minimize.config covers
// the other route, where the annotation step sits between the two.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    qc_report.skip = false

    // Produces a final document named <doc>_minimized.sky.zip.
    skyline.minimize = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
