//
// Positive test: a batch name that ends in an underscore, with the annotate step running.
//
// In batch mode the document of a batch is named <document_name>_<batch>, so a batch called
// 'Plate1_' gives a document name ending in an underscore, the same shape as in
// test-diann-document-name-underscore.config. The document name here also ends in an
// underscore, which is harmless in batch mode because the batch name follows it.
//
// Expected: success, with skyline/final_documents/mydoc__Plate1_annotated.sky.zip and
// mydoc__Plate2_annotated.sky.zip.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = ['Plate1_': 'test-resources/narrow-window',
                         'Plate2' : 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    replicate_metadata = 'test-resources/test-replicate-metadata.tsv'
    qc_report.skip = false

    skyline.document_name = 'mydoc_'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
