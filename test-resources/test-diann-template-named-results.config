//
// Stub-run config: the Skyline template file is itself named `results.sky.zip`.
//
// SKYLINE_ADD_LIB always writes its document as `results.sky.zip`. Every run publishes that
// file to skyline/add-lib, so reusing it as `skyline.template_file` is a natural thing to do.
// Staged in the task directory, the template had the same path as the step's own output:
// Skyline replaced it and, under symlink staging, deleted the file it linked to, which for a
// local template is the user's own file. The template is now staged under
// `template-document/`.
//
// The document is also named 'results', so both name collisions are covered at once.
//
// Expected: success. The SKYLINE_ADD_LIB stub fails if `results.sky.zip` is already present
// as a staged input, which is how this config fails without the staging change.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    qc_report.skip = false

    skyline.template_file = 'test-resources/template-named-results/results.sky.zip'
    skyline.document_name = 'results'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
