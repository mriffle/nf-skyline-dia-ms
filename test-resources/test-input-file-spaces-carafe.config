//
// Positive test: Carafe inputs with spaces in their names.
//
// carafe.spectra_dir, carafe.carafe_fasta and carafe.diann_fasta all have a space in their
// name, as do the MS files being quantified. See test-input-file-spaces.config for what a
// stub run can and cannot show.
//
// Expected: success, with final document 'final.sky.zip'.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/spaced inputs/mzml window'
    quant_spectra_glob = '*.mzML'

    carafe.spectra_dir = 'test-resources/spaced inputs/mzml window'
    carafe.spectra_glob = '*.mzML'
    carafe.carafe_fasta = 'test-resources/spaced inputs/test skyline.fasta'
    carafe.diann_fasta = 'test-resources/spaced inputs/test fasta.fasta'

    fasta = 'test-resources/spaced inputs/test fasta.fasta'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
