//
// Positive test: a document name that ends in the suffix of a Skyline step that does not
// run.
//
// With no replicate metadata the annotate step is skipped and the final document is
// run_annotated_minimized.sky.zip: '_annotated' belongs to the name, '_minimized' was added
// by the minimize step. A file name alone cannot tell the two apart, which is why the
// workflow no longer derives the document name from it. Cutting both suffixes off gave
// 'run', which did not match 'run_annotated', and the run failed with "Join mismatch".
//
// Expected: success, with skyline/final_documents/run_annotated_minimized.sky.zip.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    qc_report.skip = false

    skyline.document_name = 'run_annotated'
    skyline.minimize = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
