//
// Negative test: a Skyline document name with characters that cannot be in the file name.
//
// The document name becomes part of file names written by Skyline (a Windows program, so
// : * ? " < > | are out) from shell scripts (so ' ` and $ are out). Without validation a
// name like this failed inside SKYLINE_MERGE_RESULTS, after the search had finished.
// Spaces are allowed: see test-document-name-spaces.config.
//
// Expected: non-zero exit before any task runs, with a message naming the parameter. See
// .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    skyline.document_name = "it's: final?"

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
