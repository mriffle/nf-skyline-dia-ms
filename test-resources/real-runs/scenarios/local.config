// Base scenario: the same three raw files as pdc.config, read from a local directory.
// msconvert, DIA-NN (library predicted from the FASTA), Skyline. No metadata, so the
// document is `final.sky.zip`.
params {
    quant_spectra_dir  = "${System.getenv('NFDIA_TEST_HOME')}/data/raw"
    quant_spectra_glob = '*.raw'
    search_engine      = 'diann'
    fasta              = "${System.getenv('NFDIA_TEST_HOME')}/data/fasta/human_sp_q4.fasta"

    // These files' windows do not overlap, so there is nothing to demultiplex.
    msconvert.do_demultiplex  = false
    msconvert.do_simasspectra = true

    // Two Skyline reports to compare runs by.
    skyline.skyr_file = [
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/precursor_quality.skyr",
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/replicate_quality.skyr"
    ]
}
