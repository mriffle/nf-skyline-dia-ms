// Stand-alone scenario: the two Panorama Public steps for MS files
// (PANORAMA_PUBLIC_GET_MS_FILE_LIST and PANORAMA_PUBLIC_GET_MS_FILE) on one file, without
// the 3.8 GB that gpf.config downloads. One narrow-window file is listed, downloaded and
// converted, and the run stops.
//
// The download step has a storeDir, so it is skipped when the file is already in the cache.
// This scenario therefore downloads into a scratch cache of its own; delete
// $NFDIA_TEST_HOME/nf-cache/scratch-panorama-public before running it again.
params {
    panorama_cache_directory = "${System.getenv('NFDIA_TEST_HOME')}/nf-cache/scratch-panorama-public"

    quant_spectra_dir   = 'https://panoramaweb.org/_webdav/Panorama%20Public/2025/MacCoss%20-%20Stellar%20highly%20multiplex%20fluid%20assays/%40files/RawFiles/Exploris_CSF_GPF_DIA/'
    quant_spectra_glob  = '*_400-500_13.raw'
    search_engine       = 'diann'
    msconvert_only      = true
    msconvert.do_demultiplex  = true
    msconvert.do_simasspectra = true
}
