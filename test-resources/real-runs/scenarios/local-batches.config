// Stand-alone scenario: multi-batch mode from a `quant_spectra_dir` map (two directories,
// two Skyline documents: `final_Plate1`, `final_Plate2`). Use this instead of local.config,
// not on top of it: a map given in a later -c file is merged with an earlier value, not
// replaced.
params {
    quant_spectra_dir = [
        'Plate1': "${System.getenv('NFDIA_TEST_HOME')}/data/raw-batches/Plate1",
        'Plate2': "${System.getenv('NFDIA_TEST_HOME')}/data/raw-batches/Plate2"
    ]
    quant_spectra_glob = '*.raw'
    search_engine      = 'diann'
    fasta              = "${System.getenv('NFDIA_TEST_HOME')}/data/fasta/human_sp_q4.fasta"

    msconvert.do_demultiplex  = false
    msconvert.do_simasspectra = true

    skyline.skyr_file = [
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/precursor_quality.skyr",
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/replicate_quality.skyr"
    ]
}
