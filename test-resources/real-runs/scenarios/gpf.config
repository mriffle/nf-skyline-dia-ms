// Stand-alone scenario: real narrow-window (GPF) data plus matching wide-window runs, read
// straight from Panorama Public. Human CSF, Orbitrap Exploris 480, 30 minute gradient
// (project "MacCoss - Stellar highly multiplex fluid assays", ProteomeXchange PXD065471).
//
// It runs the two Panorama Public steps for real (directory listing and download), msconvert
// WITH demultiplexing (these windows overlap, unlike the PDC files), and the narrow-window
// part of the search branch: DIA-NN here, EncyclopeDIA with gpf-encyclopedia.config on top.
//
// Six narrow files (2.3 GB) and three wide files (1.5 GB) are downloaded on the first run.
// Both folders also hold an .mzML copy of every file, so the globs must end in `.raw`, and
// only the `_N01_` wide files are undiluted CSF.
params {
    quant_spectra_dir  = 'https://panoramaweb.org/_webdav/Panorama%20Public/2025/MacCoss%20-%20Stellar%20highly%20multiplex%20fluid%20assays/%40files/RawFiles/Exploris_CSF_DIA_MMCC/'
    quant_spectra_glob = '*_N01_*.raw'

    chromatogram_library_spectra_dir  = 'https://panoramaweb.org/_webdav/Panorama%20Public/2025/MacCoss%20-%20Stellar%20highly%20multiplex%20fluid%20assays/%40files/RawFiles/Exploris_CSF_GPF_DIA/'
    chromatogram_library_spectra_glob = '*.raw'

    search_engine = 'diann'
    fasta         = "${System.getenv('NFDIA_TEST_HOME')}/data/fasta/human_sp_q4.fasta"

    msconvert.do_demultiplex  = true
    msconvert.do_simasspectra = true

    skyline.skyr_file = [
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/precursor_quality.skyr",
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/replicate_quality.skyr"
    ]
}
