// Modifier for local.config: EncyclopeDIA instead of DIA-NN, wide-window files only.
// EncyclopeDIA needs a library; the .blib that a DIA-NN run of local.config publishes works.
params {
    search_engine    = 'encyclopedia'
    spectral_library = "${System.getenv('NFDIA_TEST_HOME')}/data/lib/final_diann_lib.blib"
}
