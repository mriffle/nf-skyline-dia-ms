// Base scenario: three raw files of PDC study PDC000504, downloaded by the workflow itself,
// converted with msconvert, searched with DIA-NN (library predicted from the FASTA), and
// imported into Skyline. PDC annotations are added, so the document is `<study>_annotated`.
params {
    pdc.study_id    = 'PDC000504'
    pdc.n_raw_files = 3
    search_engine   = 'diann'
    fasta           = "${System.getenv('NFDIA_TEST_HOME')}/data/fasta/human_sp_q4.fasta"

    // This study's windows do not overlap, so there is nothing to demultiplex.
    msconvert.do_demultiplex  = false
    msconvert.do_simasspectra = true

    // Two Skyline reports to compare runs by.
    skyline.skyr_file = [
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/precursor_quality.skyr",
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/replicate_quality.skyr"
    ]
}
