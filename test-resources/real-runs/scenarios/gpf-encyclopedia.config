// Modifier for gpf.config: EncyclopeDIA instead of DIA-NN. The narrow-window files are
// searched first and a chromatogram library (.elib) is built from them, then the wide files
// are searched against that library.
//
// The library is the .elib the data's authors published in the same project. Its URL is
// written with `panorama%20public` in lower case on purpose: the workflow does not download
// auxiliary files from Panorama Public, but a URL it does not recognise as public goes
// through the authenticated step (PANORAMA_GET_FILE), and Panorama accepts its published
// public key as the API key. run-case.sh puts that key in the secrets file.
params {
    search_engine    = 'encyclopedia'
    spectral_library = 'https://panoramaweb.org/_webdav/panorama%20public/2025/MacCoss%20-%20Stellar%20highly%20multiplex%20fluid%20assays/%40files/RawFiles/DBsearchFiles/Exp_CSF_GPF_A.elib'
    fasta            = "${System.getenv('NFDIA_TEST_HOME')}/data/fasta/human_sp_full.fasta"
}
