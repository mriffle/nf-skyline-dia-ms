// Stand-alone scenario: Cascadia (de novo) on two mzML files cut to four minutes of gradient.
// A full file takes about 44 minutes on an RTX 4090; these take a few minutes each.
// Add cascadia-gpu.config when the machine has a GPU that Docker can use.
params {
    quant_spectra_dir  = "${System.getenv('NFDIA_TEST_HOME')}/data/mzml-short"
    quant_spectra_glob = '*.mzML'
    search_engine      = 'cascadia'

    // Two Skyline reports to compare runs by.
    skyline.skyr_file = [
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/precursor_quality.skyr",
        "${System.getenv('NFDIA_TEST_HOME')}/data/skyr/replicate_quality.skyr"
    ]
}
