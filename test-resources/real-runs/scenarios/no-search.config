// Modifier for local.config: no search; Skyline is given a ready-made library.
// The library is the .blib that a DIA-NN run of local.config publishes (see TESTING.md).
params {
    search_engine    = null
    spectral_library = "${System.getenv('NFDIA_TEST_HOME')}/data/lib/final_diann_lib.blib"
}
