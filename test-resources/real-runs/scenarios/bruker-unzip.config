// Stand-alone scenario: extract a synthetic Bruker .d.zip and stop (msconvert_only).
// This runs UNZIP_DIRECTORY only. The archive holds no spectra, so nothing downstream of
// extraction can be tested with it.
//
// The extraction step has a storeDir, so it is skipped once its output is in the cache.
// This scenario therefore extracts into a scratch cache of its own; delete
// $NFDIA_TEST_HOME/nf-cache/scratch-bruker before running it again.
params {
    panorama_cache_directory = "${System.getenv('NFDIA_TEST_HOME')}/nf-cache/scratch-bruker"
    quant_spectra_dir  = "${System.getenv('NFDIA_TEST_HOME')}/data/bruker-synthetic"
    quant_spectra_glob = '*.d.zip'
    search_engine      = 'diann'
    msconvert_only     = true
}
