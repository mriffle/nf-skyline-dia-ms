// Stand-alone scenario: the authenticated Panorama steps for MS files
// (PANORAMA_GET_MS_FILE_LIST and PANORAMA_GET_MS_FILE), without an account. One narrow-window
// file of the gpf.config data is listed, downloaded and converted, and the run stops.
//
// `panorama%20public` is in lower case on purpose; see gpf-encyclopedia.config. The download
// step has a storeDir, so it is skipped when the file is already in the cache. This scenario
// therefore downloads into a scratch cache of its own; delete
// $NFDIA_TEST_HOME/nf-cache/scratch-panorama-auth before running it again.
params {
    panorama_cache_directory = "${System.getenv('NFDIA_TEST_HOME')}/nf-cache/scratch-panorama-auth"

    quant_spectra_dir   = 'https://panoramaweb.org/_webdav/panorama%20public/2025/MacCoss%20-%20Stellar%20highly%20multiplex%20fluid%20assays/%40files/RawFiles/Exploris_CSF_GPF_DIA/'
    quant_spectra_glob  = '*_400-500_13.raw'
    search_engine       = 'diann'
    msconvert_only      = true
    msconvert.do_demultiplex  = true
    msconvert.do_simasspectra = true
}
