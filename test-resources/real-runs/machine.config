//
// Machine settings for real (non-stub) test runs. See TESTING.md.
//
// Pass this file FIRST and the scenario files after it: when two -c files set the same
// value, the last one wins.
//
//   nextflow run <code> -c machine.config -c scenarios/local.config [-c scenarios/<modifier>.config]
//
// Everything is read from the environment so that the file is the same on every machine:
//
//   NFDIA_TEST_HOME    the test cache (required; see TESTING.md, "The test cache")
//   NFDIA_TEST_CPUS    cap on CPUs per task (default 4)
//   NFDIA_TEST_MEMORY  cap on memory per task (default 10.GB)
//   NFDIA_TEST_FORKS   tasks run at once by one workflow (default 3)
//
process.resourceLimits = [
    cpus: (System.getenv('NFDIA_TEST_CPUS') ?: '4') as Integer,
    memory: System.getenv('NFDIA_TEST_MEMORY') ?: '10.GB',
    time: '6.h'
]
executor.queueSize = (System.getenv('NFDIA_TEST_FORKS') ?: '3') as Integer

params {
    // The `standard` profile puts both of these under /data, which rarely exists.
    // If the variable is unset these point at a directory that cannot be created, so the
    // run stops instead of quietly caching somewhere unexpected.
    mzml_cache_directory     = "${System.getenv('NFDIA_TEST_HOME') ?: '/NFDIA_TEST_HOME-is-not-set'}/nf-cache/mzml"
    panorama_cache_directory = "${System.getenv('NFDIA_TEST_HOME') ?: '/NFDIA_TEST_HOME-is-not-set'}/nf-cache/panorama"
}
