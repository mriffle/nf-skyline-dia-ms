//
// Positive test: every user-supplied input file has a space in its name, and so does the
// directory it is in (DIA-NN path, narrow- and wide-window data).
//
// Covered here: quant_spectra_dir, chromatogram_library_spectra_dir, fasta, skyline.fasta,
// skyline.template_file, replicate_metadata and skyline.skyr_file. Annotation and minimize
// are both on so the metadata file's name passes through ANNOTATION_TSV_TO_CSV and
// SKYLINE_ANNOTATE_DOCUMENT, and the result is uploaded so the upload manifest shows the
// names unchanged.
//
// A stub run executes none of the tools, so this checks what Nextflow does with the names
// (staging, declared outputs, channel joins, the checksum table, the upload manifest) and
// the stub blocks that derive file names from an input's name. That the tools themselves
// accept the names was checked with real runs.
//
// Expected: success, with final document 'final_annotated_minimized.sky.zip'.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/spaced inputs/wide window'
    quant_spectra_glob = '*.raw'

    chromatogram_library_spectra_dir = 'test-resources/spaced inputs/narrow window'
    chromatogram_library_spectra_glob = '*.raw'

    fasta = 'test-resources/spaced inputs/test fasta.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    replicate_metadata = 'test-resources/spaced inputs/test replicate metadata.tsv'

    skyline.fasta = 'test-resources/spaced inputs/test skyline.fasta'
    skyline.template_file = 'test-resources/spaced inputs/test template.sky.zip'
    skyline.skyr_file = 'test-resources/spaced inputs/test report.skyr'
    skyline.minimize = true

    // The URL is never contacted: stub runs only record the destination.
    panorama.upload = true
    panorama.upload_url = 'https://panoramaweb.org/_webdav/stub/%40files/test'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
