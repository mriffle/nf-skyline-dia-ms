//
// Negative test: two batches whose final Skyline documents would get the same file name.
//
// The annotate and minimize suffixes replace a trailing underscore, so with replicate
// metadata the batches 'Plate1' and 'Plate1_' would both write
// final_Plate1_annotated.sky.zip. Both are published to skyline/final_documents, where one
// would overwrite the other.
//
// Expected: non-zero exit before any task runs, naming both batches and the shared document
// name. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1' : 'test-resources/narrow-window',
                         'Plate1_': 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    replicate_metadata = 'test-resources/test-replicate-metadata.tsv'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
