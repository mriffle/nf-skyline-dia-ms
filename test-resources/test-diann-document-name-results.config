//
// Stub-run config: the Skyline document is named 'results'.
//
// SKYLINE_ADD_LIB hands its document to the import and merge steps as `results.sky.zip`.
// Without replicate metadata and without the minimize step, the merge step shares the final
// document as `<skyline.document_name>.sky.zip` in its own task directory. With the name
// 'results' those two are the same file name, so the merge task used to overwrite its own
// staged input.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    qc_report.skip = false

    skyline.document_name = 'results'
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
