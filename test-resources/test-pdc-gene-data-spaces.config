//
// Negative test: pdc.gene_level_data with a space in its file name.
//
// Input files may have spaces in their names, with this one exception: the gene-level table
// is read by EXPORT_GENE_REPORTS, part of the QC reporting code, which has not been made to
// cope with one. The run must stop at startup with a message naming the parameter rather
// than fail in the last step. The space in the directory name is not what is rejected.
//
// Expected: failure, with "Parameter `pdc.gene_level_data` points to a file with whitespace
// in its name".
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.study_name = 'test_pdc_study'
    pdc.metadata_tsv = 'test-resources/test-pdc-metadata.tsv'
    pdc.gene_level_data = 'test-resources/spaced inputs/test gene metadata.tsv'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    qc_report.skip = false
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
