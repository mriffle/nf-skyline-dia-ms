//
// Negative test: a batch name with a character that cannot be in a Skyline document name.
//
// In multi-batch mode the batch name is part of the document name
// (`<document_name>_<batch>.sky.zip`), so the characters rejected in `skyline.document_name`
// (see test-document-name-invalid.config) cannot be in a batch name either. Without this
// check a name like 'Plate:2' failed inside SKYLINE_MERGE_RESULTS, after the search had
// finished: Skyline is a Windows program and cannot write a file with ':' in its name.
//
// The check applies only when a Skyline document is made. validate_batch_names, which
// rejects '/' and '\', applies to every run (see test-batch-name-invalid.config).
//
// Expected: non-zero exit before any task runs, with a message naming `quant_spectra_dir`
// and the offending batch name. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1' : 'test-resources/narrow-window',
                         'Plate:2': 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
