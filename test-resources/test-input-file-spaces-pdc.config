//
// Positive test: PDC inputs with spaces in their names.
//
// pdc.metadata_tsv and pdc.batch_file are in a directory with a space and have a space in
// their own names, and the PDC file names listed in them contain spaces too. See
// test-input-file-spaces.config for what a stub run can and cannot show.
//
// Expected: success, with final documents 'test_pdc_study_BatchA_annotated.sky.zip' and
// 'test_pdc_study_BatchB_annotated.sky.zip'.
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.study_name = 'test_pdc_study'
    pdc.metadata_tsv = 'test-resources/spaced inputs/test pdc metadata.tsv'
    pdc.batch_file = 'test-resources/spaced inputs/test pdc batch file.tsv'

    fasta = 'test-resources/spaced inputs/test fasta.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
