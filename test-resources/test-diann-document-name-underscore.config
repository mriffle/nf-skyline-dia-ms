//
// Positive test: a document name that ends in an underscore, with the annotate and
// minimize steps both running.
//
// The annotate and minimize suffixes replace a trailing underscore, so the final document of
// 'mydoc_' is mydoc_annotated_minimized.sky.zip. The workflow used to recover the document
// name by cutting the suffixes off that file name, got 'mydoc', and failed with
// "Join mismatch ... key=mydoc ... key=mydoc_" after every Skyline step had finished. It now
// matches documents to batches by the file name it expects the last step to write.
//
// qc_report.skip is false so the matched document is actually consumed downstream.
//
// Expected: success, with skyline/final_documents/mydoc_annotated_minimized.sky.zip.
//

params {
    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = true
    msconvert.do_simasspectra = true

    replicate_metadata = 'test-resources/test-replicate-metadata.tsv'
    qc_report.skip = false

    skyline.document_name = 'mydoc_'
    skyline.minimize = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
